<Window x:Class="BKDayzModDownloader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BK DayZ Mod Downloader" Width="1180" Height="820" MinWidth="1000" MinHeight="740" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowBorder" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" TextElement.Foreground="{DynamicResource Ink}">
  <Grid>
    <Grid x:Name="LoginPage" Margin="0,40,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="52">
        <Grid><StackPanel VerticalAlignment="Center">
          <TextBlock Text="BK / TOOLS" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,40" />
          <TextBlock Text="DayZ 模组，&#10;集中下载。" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="38" LineHeight="56" />
          <TextBlock Text="工坊 ID 下载 · 实时进度 · 下载队列" Foreground="{DynamicResource Muted}" Margin="0,25,0,0" FontSize="13" />
        </StackPanel><TextBlock Text="DEPOTDOWNLOADER / WINDOWS x64" Foreground="{DynamicResource Faint}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Bottom" /></Grid>
      </Border>
      <Grid Grid.Column="1" Margin="62,42">
        <StackPanel VerticalAlignment="Center" MaxWidth="380">
          <TextBlock Text="登录 Steam" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="使用拥有 DayZ 和相应工坊访问权限的账号。" Foreground="{DynamicResource Muted}" Margin="0,10,0,28" TextWrapping="Wrap" />
          <TextBlock Text="账号" Margin="0,0,0,7" />
          <TextBox x:Name="UsernameBox" AutomationProperties.Name="Steam账号" />
          <TextBlock Text="密码" Margin="0,18,0,7" />
          <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Steam密码" KeyDown="Password_KeyDown" />
          <CheckBox x:Name="RememberBox" Content="在当前 Windows 用户下记住登录状态" Margin="0,18,0,0" />
          <Button x:Name="LoginButton" Content="登录并进入下载" Style="{StaticResource Primary}" Margin="0,24,0,0" Click="Login_Click" />
          <Button x:Name="CancelLoginButton" Content="取消登录" Margin="0,10,0,0" Visibility="Collapsed" Click="Cancel_Click" />
          <ProgressBar x:Name="LoginProgress" Height="3" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          <TextBlock x:Name="LoginStatus" Text="密码仅用于本次登录，不写入配置或日志。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,15,0,0" LineHeight="22" />
          <Button Content="清除保存的登录状态" HorizontalAlignment="Left" Padding="0,7" BorderThickness="0" Background="Transparent" Margin="0,14,0,0" Foreground="{DynamicResource Muted}" Click="Forget_Click" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="DownloadPage" Visibility="Collapsed" Margin="28,60,28,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="下载队列" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="AccountLabel" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Content="下载设置" Margin="0,0,8,0" Click="Settings_Click" />
          <Button x:Name="LogsButton" Content="日志" MinWidth="72" Margin="0,0,8,0" Click="ToggleLogs_Click" AutomationProperties.Name="展开或折叠日志" />
          <Button Content="退出登录" Click="Logout_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="LogGapColumn" Width="0" />
          <ColumnDefinition x:Name="LogPanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
            <Grid Margin="16,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="任务" FontWeight="Medium" /><Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="{Binding Mods.Count}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Muted}" /></Border></StackPanel>
              <Button x:Name="ImportButton" Grid.Column="1" Content="导入清单" FontSize="12" Padding="10,5" Click="Import_Click" />
            </Grid>
            <DataGrid x:Name="ModGrid" Grid.Row="1" ItemsSource="{Binding Mods}" RowHeight="64" MinHeight="100" CanUserSortColumns="True" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="36">
                  <DataGridTemplateColumn.Header><CheckBox ToolTip="全选 / 取消全选" Click="SelectAll_Click" AutomationProperties.Name="全选下载队列" /></DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="勾选此模组" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="模组" Width="*" MinWidth="155" SortMemberPath="Name">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Border Width="24" Height="28" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource Subtle}"><Path Data="{StaticResource ModIcon}" Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1" /></Border>
                      <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Id, StringFormat=ID {0}}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0" /></StackPanel>
                    </Grid>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="状态" Width="94" SortMemberPath="Status">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Margin="0,0,5,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Faint}" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="下载中"><Setter Property="Fill" Value="{DynamicResource Success}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已完成"><Setter Property="Fill" Value="{DynamicResource Success}" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Fill" Value="{DynamicResource Danger}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" /></StackPanel>
                    </Border>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="进度" Width="154" SortMemberPath="Progress">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Grid ToolTip="{Binding Detail}">
                      <TextBlock Text="—" Foreground="{DynamicResource Faint}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowProgress}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BoolVisibility}}">
                        <DockPanel><TextBlock Text="{Binding ProgressLabel}" DockPanel.Dock="Right" Width="43" TextAlignment="Right" FontFamily="Consolas" FontSize="11" /><ProgressBar Height="4" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" VerticalAlignment="Center" /></DockPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="90"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTemplateColumn Header="操作" Width="136">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RowAction}" IsEnabled="{Binding CanStart}" Click="RowStart_Click" ToolTip="{Binding StartTooltip}" AutomationProperties.Name="下载或继续此模组"><Path Data="{StaticResource DownloadIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
                    <Button Style="{StaticResource RowAction}" IsEnabled="{Binding CanPause}" Click="RowPause_Click" ToolTip="暂停下载" AutomationProperties.Name="暂停此模组"><Path Data="{StaticResource PauseIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" /></Button>
                    <Button Style="{StaticResource RowAction}" IsEnabled="{Binding CanCancel}" Click="RowCancel_Click" ToolTip="取消下载，保留已有文件" AutomationProperties.Name="取消此模组下载"><Path Data="{StaticResource CancelIcon}" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
                    <Button Style="{StaticResource RowAction}" IsEnabled="{Binding CanDelete}" Click="RowDelete_Click" ToolTip="从队列删除，保留已有文件" AutomationProperties.Name="从队列删除此模组"><Path Data="{StaticResource DeleteIcon}" Width="13" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" /></Button>
                  </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
              <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="ToolTip" Value="{Binding Error}" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Subtle}" /></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
            </DataGrid>
            <TextBlock Grid.Row="2" Text="点击右下角 ＋ 添加单个模组，或在右上方导入清单。" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="18,0,84,0" TextWrapping="Wrap" />
            <Button x:Name="AddModButton" Grid.Row="2" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Click="ShowAddMod_Click" ToolTip="添加模组" AutomationProperties.Name="添加模组">
              <Button.Template><ControlTemplate TargetType="Button">
                <Border x:Name="Circle" Background="{DynamicResource Accent}" CornerRadius="26">
                  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.15" /></Border.Effect>
                  <TextBlock Text="＋" Foreground="{DynamicResource Surface}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Button.Template>
            </Button>
          </Grid>
        </Border>

        <Border x:Name="LogPanel" Grid.Column="2" Visibility="Collapsed" Background="#080D0A" CornerRadius="10" Padding="16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="运行日志" Foreground="#68EF9E" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="收起" Foreground="#68EF9E" Background="Transparent" BorderThickness="0" Padding="4,2" HorizontalAlignment="Right" Click="ToggleLogs_Click" />
            </DockPanel>
            <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" Background="#080D0A" Foreground="#68EF9E" BorderThickness="0" CaretBrush="#68EF9E" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Padding="0" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            <Button Grid.Row="2" Content="打开日志目录" Foreground="#68EF9E" Background="Transparent" BorderBrush="#244B35" Margin="0,14,0,0" Click="OpenLogs_Click" />
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding CurrentDetail}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
          <TextBlock Grid.Column="1" Text="{Binding QueueText, StringFormat=已完成 {0}}" Foreground="{DynamicResource Muted}" FontSize="11" />
        </Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StartQueueButton" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="StartQueue_Click" ToolTip="开始或继续所有勾选任务" AutomationProperties.Name="开始下载勾选任务"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SelectedIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Margin="0,0,8,0" /><TextBlock Text="开始下载" /></StackPanel></Button>
          <Button Margin="0,0,8,0" Click="PauseQueue_Click" ToolTip="暂停所有勾选任务" AutomationProperties.Name="暂停下载勾选任务"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SelectedIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Margin="0,0,8,0" /><TextBlock Text="暂停下载" /></StackPanel></Button>
          <Button Margin="0,0,8,0" Click="CancelQueue_Click" ToolTip="取消所有勾选任务，保留文件" AutomationProperties.Name="取消下载勾选任务"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SelectedIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Margin="0,0,8,0" /><TextBlock Text="取消下载" /></StackPanel></Button>
          <Button Click="DeleteQueue_Click" ToolTip="删除所有勾选任务，保留文件" AutomationProperties.Name="删除勾选任务"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SelectedIcon}" Width="13" Height="13" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Margin="0,0,8,0" /><TextBlock Text="删除" /></StackPanel></Button>
        </StackPanel>
          <Button Grid.Column="1" Content="打开下载目录" Click="OpenDownloads_Click" ToolTip="{Binding Text, ElementName=RootBox}" AutomationProperties.Name="打开下载目录" />
        </Grid>
      </Grid>

      <Popup x:Name="AddModPopup" PlacementTarget="{Binding ElementName=AddModButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-330" VerticalOffset="-10">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="22" Width="390" Margin="10">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.15" /></Border.Effect>
          <StackPanel>
            <TextBlock Text="添加模组" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="输入工坊 Mod ID 或 Steam 工坊链接" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,12" />
            <TextBox x:Name="ModIdBox" AutomationProperties.Name="Mod ID" KeyDown="ModId_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="AddButton" Content="加入队列" Margin="0,0,8,0" Click="Add_Click" />
              <Button x:Name="DownloadButton" Content="添加并下载" Style="{StaticResource Primary}" Click="Download_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-250" VerticalOffset="8">
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="22" Width="440" Margin="10">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.15" /></Border.Effect>
          <StackPanel>
            <TextBlock Text="下载设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
            <TextBlock Text="保存目录" Margin="0,0,0,7" />
            <DockPanel><Button Content="浏览…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" /><TextBox x:Name="RootBox" MinWidth="200" AutomationProperties.Name="下载保存目录" LostFocus="Root_LostFocus" /></DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,18"><TextBlock Text="数据块并发" VerticalAlignment="Center" /><ComboBox x:Name="ChunksBox" Width="70" Margin="12,0,0,0" SelectedIndex="2"><ComboBoxItem Content="2" /><ComboBoxItem Content="4" /><ComboBoxItem Content="8" /><ComboBoxItem Content="16" /></ComboBox></StackPanel>
            <CheckBox x:Name="ValidateBox" Content="校验已有文件" IsChecked="True" Margin="0,0,0,12" />
            <CheckBox x:Name="RetryAutoBox" Content="失败后重试 3 次（间隔 30 秒）" IsChecked="True" />
            <Button Content="完成" HorizontalAlignment="Right" Style="{StaticResource Primary}" Margin="0,20,0,0" Click="CloseSettings_Click" />
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
    <!-- WindowChrome provides native drag, double-click maximize and resize hit-testing. -->
    <Grid Height="40" VerticalAlignment="Top" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" IsHitTestVisible="False">
        <TextBlock Text="BK" FontWeight="SemiBold" FontSize="13" /><TextBlock Text=" / " Foreground="{DynamicResource LineStrong}" Margin="8,0" /><TextBlock Text="DAYZ MOD DOWNLOADER" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" FontFamily="Consolas" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="ThemeButton" Content="暗色模式" Height="28" Padding="10,4" FontSize="11" Margin="0,5,14,0" Click="Theme_Click" AutomationProperties.Name="切换亮色或暗色模式" />
        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="最小化" ToolTip="最小化"><Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" /></Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="最大化或还原" ToolTip="最大化或还原"><Path x:Name="MaximizeGlyph" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" /></Button>
        <Button Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="关闭" ToolTip="关闭"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" /></Button>
      </StackPanel>
    </Grid>
  </Grid>
  </Border>
</Window>
